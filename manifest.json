{
  "manifest_version": 3,
  "name": "TabPilot – Tab & Session Manager",
  "short_name": "TabPilot",
  "version": "1.0.0",
  "description": "Local-first tab search, workspaces, saved sessions, duplicate detection, crash recovery and safe tab cleanup.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TabPilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "sessions", "favicon"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open TabPilot quick search"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open the TabPilot dashboard"
    },
    "save-window": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current window as a session"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
